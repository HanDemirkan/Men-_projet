# =============================================================================
# QR Platform - Development environment
#
# Kopyalayıp `.env.development` olarak kaydedin (repo köküne):
#   cp .env.development.example .env.development
#
# `pnpm dev`, `pnpm dev:web`, `pnpm dev:api`, `pnpm dev:worker`, `pnpm test`
# ve `pnpm test:e2e` bu dosyayı otomatik yükler (bkz. kök package.json,
# dotenv-cli sarmalaması).
#
# Önkoşullar (Docker YOK, hepsi native/yerel çalışır):
#   - PostgreSQL 16+ (Windows: postgresql.org installer / Ubuntu: apt) - bkz. docs/setup/postgresql.md
#   - Redis-uyumlu bir servis (Windows: Memurai / Ubuntu: apt redis-server) - bkz. docs/setup/redis.md
# =============================================================================

NODE_ENV=development

# Development default is 3001 (not Next.js's usual 3000) so it doesn't
# collide with another local project's dev server on port 3000. `next dev`/
# `next start` only ever read the generic PORT var (see ecosystem.config.cjs's
# comment for the same caveat in production), so both are set and must stay
# in sync if you change this.
WEB_PORT=3001
PORT=3001
API_PORT=4000
API_HOST=0.0.0.0
WORKER_PORT=4100

# --- PostgreSQL (yerel kurulum) ---
POSTGRES_DB=qr_platform
POSTGRES_USER=qr_platform_user
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qr_platform_user:change-me-in-local-env@localhost:5432/qr_platform?schema=public

# --- Redis (Memurai/yerel Redis, parolasız varsayılan) ---
REDIS_URL=redis://localhost:6379

# --- Storage ---
# Windows örneği aşağıda; macOS/Linux'ta ör. /home/<kullanici>/qr-platform-data/storage kullanın.
# Repo dizininin dışında olmalı.
STORAGE_DIR=C:\qr-platform-data\storage
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp

# --- Rate limiting (development'ta gevşek, production'da sıkılaştırılır) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=1000

# --- Web ---
# Browser-facing API URL (inlined into the client bundle). To test a QR code
# from your phone, set this - and PUBLIC_APP_URL below and
# CORS_ALLOWED_ORIGINS - to your machine's current LAN IP instead of
# localhost. See docs/setup/lan-access.md.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side (Next.js Server Components) API URL - safe to leave on
# localhost even when testing over LAN, since Server Components run on this
# same machine.
API_SERVER_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:3001
# Externally-reachable web origin QR codes are generated against.
PUBLIC_APP_URL=http://localhost:3001

# --- Auth ---
# Generate a real one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-secret

# --- API ---
CORS_ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=debug
REQUEST_BODY_LIMIT=1mb

# --- Bootstrap (yalnızca `pnpm bootstrap:admin` çalıştırılırken okunur) ---
# İlk SUPER_ADMIN hesabını oluşturur - bkz. README "İlk Kurulum". İkinci kez
# çalıştırıldığında hesap zaten varsa hiçbir şey değiştirmez (idempotent).
BOOTSTRAP_ADMIN_NAME="Platform Admin"
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# --- Development auto super admin (yalnızca NODE_ENV=development'ta okunur) ---
# `pnpm dev` başlatıldığında API bu hesabı otomatik oluşturur/hazır tutar -
# ayrı bir `pnpm bootstrap:admin` çalıştırmaya gerek yok. Kendi yerel
# `.env.development` dosyanızda bu üç satırı kendi geliştirme hesabınızla
# değiştirin (Git'e eklenmez).
DEV_ADMIN_NAME="Dev Admin"
DEV_ADMIN_EMAIL=dev-admin@example.com
DEV_ADMIN_PASSWORD=DevAdmin123!

# Web login formunun bu hesabı otomatik doldurabilmesi için (yalnızca
# development build'inde inline edilir, production build'e asla eklenmez -
# bkz. apps/web/src/lib/env.ts). DEV_ADMIN_EMAIL/PASSWORD ile aynı değerler olmalı.
NEXT_PUBLIC_DEV_ADMIN_EMAIL=dev-admin@example.com
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=DevAdmin123!
