# =============================================================================
# QR Platform - Environment Variables Example
# Copy this file to .env and adjust the values for your local environment.
# Never commit the real .env file.
# =============================================================================

# --- General ---
NODE_ENV=development

# --- Application ports ---
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4100

# --- PostgreSQL ---
POSTGRES_DB=qr_platform
POSTGRES_USER=qr_platform_user
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qr_platform_user:change-me-in-local-env@localhost:5432/qr_platform?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=change-me-access-key
MINIO_SECRET_KEY=change-me-secret-key
MINIO_BUCKET=qr-platform-local

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- API ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
REQUEST_BODY_LIMIT=1mb
