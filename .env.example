# =============================================================================
# QR Platform - Environment Variables Example
#
# Bu proje NODE_ENV'e göre ayrılmış env dosyaları kullanır:
#   .env.development  -> `pnpm dev` / `pnpm dev:*` tarafından okunur
#   .env.production    -> `pnpm start:*` ve PM2 (ecosystem.config.cjs) tarafından okunur
#
# Bu dosya (.env.example) yalnızca genel referans/şablon amaçlıdır; gerçek
# kurulum için `.env.development.example` veya `.env.production.example`
# dosyasını kopyalayın. Gerçek `.env*` dosyaları asla Git'e eklenmez.
# =============================================================================

# --- General ---
NODE_ENV=development

# --- Application ports ---
# Development default is 3001 (not Next.js's usual 3000) to avoid colliding
# with another local project on port 3000. `next dev`/`next start` only ever
# read the generic PORT var, so both are set and must stay in sync.
WEB_PORT=3001
PORT=3001
API_PORT=4000
WORKER_PORT=4100

# --- PostgreSQL ---
# DATABASE_URL tek doğruluk kaynağıdır; POSTGRES_* değişkenleri yalnızca
# backup/restore script'leri (infrastructure/scripts/*-postgres.sh) tarafından
# kullanılır ve DATABASE_URL ile tutarlı olmalıdır.
POSTGRES_DB=qr_platform
POSTGRES_USER=qr_platform_user
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qr_platform_user:change-me-in-local-env@localhost:5432/qr_platform?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Storage (yerel disk, packages/storage) ---
# Mutlak yol olmalı ve uygulama dizininin DIŞINDA olmalı (build/deploy sırasında silinmemesi için).
STORAGE_DIR=/var/lib/qr-platform/storage
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp

# --- Rate limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:3001

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-secret

# --- API ---
CORS_ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=debug
REQUEST_BODY_LIMIT=1mb

# --- Bootstrap (yalnızca `pnpm bootstrap:admin` çalıştırılırken okunur) ---
# İlk (ve yalnızca ilk) SUPER_ADMIN hesabını oluşturur - bkz. README "İlk Kurulum".
# Komut idempotent'tir: bu hesap zaten varsa şifre güncellenmez, ikinci bir
# hesap oluşturulmaz. Şifre en az 8 karakter, en az bir harf ve bir rakam
# içermelidir. Bootstrap tamamlandıktan sonra bu satırları dosyanızdan silin.
BOOTSTRAP_ADMIN_NAME="Platform Admin"
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# --- Development auto super admin (yalnızca NODE_ENV=development'ta, `pnpm dev`
# başlangıcında okunur - production'da hiçbir etkisi yoktur, orada bırakmayın) ---
DEV_ADMIN_NAME="Dev Admin"
DEV_ADMIN_EMAIL=dev-admin@example.com
DEV_ADMIN_PASSWORD=DevAdmin123!
NEXT_PUBLIC_DEV_ADMIN_EMAIL=dev-admin@example.com
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=DevAdmin123!
