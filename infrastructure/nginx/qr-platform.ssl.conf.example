# Production HTTPS example, layered on top of infrastructure/nginx/nginx.conf.
#
# Prerequisites (see docs/setup/nginx.md):
#   1. DNS for <your-domain> already points at this server.
#   2. Base config (infrastructure/nginx/nginx.conf) is installed and working over plain HTTP.
#   3. certbot is installed: `sudo apt install certbot python3-certbot-nginx`
#   4. Certificates issued once via:
#        sudo certbot --nginx -d <your-domain>
#      (certbot can rewrite this file automatically the first time; the
#      server blocks below are what it converges on, kept here so the
#      intended end-state is version-controlled and reviewable.)
#
# Copy/merge this into /etc/nginx/sites-available/qr-platform, replacing
# <your-domain> throughout, then:
#   sudo ln -s /etc/nginx/sites-available/qr-platform /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
  listen 80;
  server_name <your-domain>;

  # Let certbot's HTTP-01 challenge through, redirect everything else to HTTPS.
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name <your-domain>;

  ssl_certificate /etc/letsencrypt/live/<your-domain>/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/<your-domain>/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  # OCSP stapling - requires the certbot-issued chain above.
  ssl_stapling on;
  ssl_stapling_verify on;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  server_tokens off;
  client_max_body_size 20m;

  location /api/ {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
  }

  location /uploads/ {
    alias /var/lib/qr-platform/storage/public/;
    add_header X-Content-Type-Options nosniff always;
    autoindex off;
    try_files $uri =404;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
