# =============================================================================
# QR Platform - Production environment
#
# Sunucuda kopyalayıp `.env.production` olarak kaydedin (repo köküne):
#   cp .env.production.example .env.production
#   chmod 600 .env.production   # yalnızca uygulama kullanıcısı okuyabilsin
#
# `pnpm start:web`, `pnpm start:api`, `pnpm start:worker` ve PM2
# (ecosystem.config.cjs, `NODE_ENV=production pm2 start ecosystem.config.cjs`)
# bu dosyayı otomatik yükler.
#
# GÜVENLİK: Bu dosyayı ASLA Git'e eklemeyin. Gerçek parolalar/secret'lar
# yalnızca sunucu üzerinde, bu dosyada (veya bir secret manager'da) yaşar.
# Kurulum sırası için bkz. docs/setup/production-ubuntu.md
# =============================================================================

NODE_ENV=production

WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4100

# --- PostgreSQL ---
POSTGRES_DB=qr_platform
POSTGRES_USER=qr_platform_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qr_platform_user:REPLACE_WITH_STRONG_SECRET@127.0.0.1:5432/qr_platform?schema=public

# --- Redis (bind 127.0.0.1, requirepass zorunlu - bkz. docs/setup/redis.md) ---
REDIS_URL=redis://:REPLACE_WITH_STRONG_SECRET@127.0.0.1:6379

# --- Storage (uygulama dizini dışında, kalıcı bir yol) ---
STORAGE_DIR=/var/lib/qr-platform/storage
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp

# --- Rate limiting (production'da sıkı) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# --- Web ---
NEXT_PUBLIC_API_URL=https://example.com/api/v1

# --- API ---
# Gerçek domain(ler) ile değiştirin; virgülle ayrılmış birden fazla origin desteklenir.
# CORS_ALLOWED_ORIGINS'de localhost bırakılırsa merkezi env doğrulaması başlangıçta hata verir.
CORS_ALLOWED_ORIGINS=https://example.com
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
