# =============================================================================
# QR Platform - Production environment
#
# Sunucuda kopyalayıp `.env.production` olarak kaydedin (repo köküne):
#   cp .env.production.example .env.production
#   chmod 600 .env.production   # yalnızca uygulama kullanıcısı okuyabilsin
#
# `pnpm start:web`, `pnpm start:api`, `pnpm start:worker` ve PM2
# (ecosystem.config.cjs, `NODE_ENV=production pm2 start ecosystem.config.cjs`)
# bu dosyayı otomatik yükler.
#
# GÜVENLİK: Bu dosyayı ASLA Git'e eklemeyin. Gerçek parolalar/secret'lar
# yalnızca sunucu üzerinde, bu dosyada (veya bir secret manager'da) yaşar.
# Kurulum sırası için bkz. docs/setup/production-ubuntu.md
# =============================================================================

NODE_ENV=production

WEB_PORT=3000
API_PORT=4000
# 127.0.0.1, not 0.0.0.0 - Nginx (infrastructure/nginx/nginx.conf) is the
# only public entry point and already proxies to 127.0.0.1:4000; the API
# itself should never be directly reachable from the internet.
API_HOST=127.0.0.1
WORKER_PORT=4100

# --- PostgreSQL ---
POSTGRES_DB=qr_platform
POSTGRES_USER=qr_platform_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qr_platform_user:REPLACE_WITH_STRONG_SECRET@127.0.0.1:5432/qr_platform?schema=public

# --- Redis (bind 127.0.0.1, requirepass zorunlu - bkz. docs/setup/redis.md) ---
REDIS_URL=redis://:REPLACE_WITH_STRONG_SECRET@127.0.0.1:6379

# --- Storage (uygulama dizini dışında, kalıcı bir yol) ---
STORAGE_DIR=/var/lib/qr-platform/storage
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp

# --- Rate limiting (production'da sıkı) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# --- Web ---
NEXT_PUBLIC_API_URL=https://example.com/api/v1
# Server-side (Next.js Server Components) requests can stay on localhost -
# Nginx proxies web+API on the same host - which is faster than a round trip
# through the public domain.
API_SERVER_URL=http://127.0.0.1:4000/api/v1
WEB_APP_URL=https://example.com
# Same as WEB_APP_URL in production (both are the one public domain) - kept
# as its own var only because development needs them to differ (LAN IP for
# QR vs localhost for links). See PUBLIC_APP_URL in
# packages/validation/src/env.schema.ts.
PUBLIC_APP_URL=https://example.com

# --- Auth ---
# Generate a real one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this secret invalidates every existing session immediately.
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# --- API ---
# Gerçek domain(ler) ile değiştirin; virgülle ayrılmış birden fazla origin desteklenir.
# CORS_ALLOWED_ORIGINS'de localhost bırakılırsa merkezi env doğrulaması başlangıçta hata verir.
CORS_ALLOWED_ORIGINS=https://example.com
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb

# --- Bootstrap (yalnızca `pnpm bootstrap:admin` çalıştırılırken okunur) ---
# Platformun ilk SUPER_ADMIN hesabını oluşturur - bkz. README "İlk Kurulum".
# GERÇEK, güçlü bir şifre kullanın; bootstrap tamamlandıktan sonra bu üç
# satırı sunucudaki .env.production dosyasından silin.
BOOTSTRAP_ADMIN_NAME="Platform Admin"
BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_REAL_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
