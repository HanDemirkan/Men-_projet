  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,app -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"nodemon --watch dist --delay 300ms dist/main.js\"",
