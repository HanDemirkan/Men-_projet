    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@qr-platform/database": "workspace:*",
    "@qr-platform/permissions": "workspace:*",
    "@qr-platform/shared": "workspace:*",
    "@qr-platform/storage": "workspace:*",
    "@qr-platform/validation": "workspace:*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
