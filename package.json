{
  "name": "qr-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "dotenv -e .env.development -- turbo run dev",
    "dev:web": "dotenv -e .env.development -- turbo run dev --filter=@qr-platform/web",
    "dev:api": "dotenv -e .env.development -- turbo run dev --filter=@qr-platform/api",
    "dev:worker": "dotenv -e .env.development -- turbo run dev --filter=@qr-platform/worker",
    "build": "turbo run build",
    "start:web": "dotenv -e .env.production -- turbo run start --filter=@qr-platform/web",
    "start:api": "dotenv -e .env.production -- turbo run start --filter=@qr-platform/api",
    "start:worker": "dotenv -e .env.production -- turbo run start --filter=@qr-platform/worker",
    "lint": "turbo run lint",
    "test": "dotenv -e .env.development -v NODE_ENV=test -- turbo run test",
    "test:e2e": "dotenv -e .env.development -v NODE_ENV=test -- turbo run test:e2e && dotenv -e .env.development -v NODE_ENV=test -- playwright test --config=tests/playwright.config.ts",
    "test:lighthouse": "dotenv -e .env.production -- turbo run build && dotenv -e .env.production -- playwright test --config=tests/lighthouse.config.ts",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "db:generate": "pnpm --filter @qr-platform/database db:generate",
    "db:migrate": "dotenv -e .env.development -- pnpm --filter @qr-platform/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @qr-platform/database db:migrate:deploy",
    "db:studio": "dotenv -e .env.development -- pnpm --filter @qr-platform/database db:studio",
    "bootstrap:admin": "pnpm --filter @qr-platform/database bootstrap:admin"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.1",
    "@qr-platform/database": "workspace:*",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.4",
    "playwright-lighthouse": "^4.0.0",
    "pm2": "^5.4.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
